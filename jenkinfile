pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                git(
                    url: 'https://github.com/mca014ashritha-design/Grafana.git',
                    branch: 'main'
                )
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t myapp:latest .'
            }
        }

        stage('Stop Old Container') {
            steps {
                sh 'docker rm -f myapp || true'
            }
        }

        stage('Run New Container') {
            steps {
                sh '''
                docker run -d \
                --name myapp \
                -p 8081:80 \
                myapp:latest
                '''
            }
        }
    }
}
